PYTHON_BASE=/path/to/python3

# Qwen3 Base preserves the reference voice; it does not apply emotion instructions.
# For cloning plus style instructions, mlx-community/VoxCPM2-8bit is compatible.
TTS_MODEL_ID=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit
TTS_VOICE=
TTS_LANGUAGE=auto
# Relative paths resolve against this service directory. Clear to disable cloning.
TTS_REF_AUDIO=./speaker.wav
TTS_REF_TEXT=你睇吓你，功課又唔做，考試淨係識得出貓
# Optional stable voice description; phrase emotion is appended automatically.
TTS_VOICE_STYLE=
TTS_HOST=127.0.0.1
TTS_PORT=8002
TTS_MAX_TEXT_CHARS=2000
TTS_MAX_AUDIO_SECONDS=120
TTS_MAX_TOKENS=1024
