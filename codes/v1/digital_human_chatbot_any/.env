PYTHON_BASE=~/.common-venv/python3.12/bin/python3

LLM_BASE_URL=https://lmstudio.octopus-tech.com/v1
LLM_API_KEY=noapikey
LLM_MODEL_NAME=qwen/qwen3.6-35b-a3b

# Local speech services
ASR_BASE_URL=http://127.0.0.1:38001
TTS_BASE_URL=http://127.0.0.1:38002

# Chatbot runtime defaults (speech model settings stay in the service folders)
APP_HOST=127.0.0.1
APP_PORT=8000
LLM_STREAM=true
LLM_MAX_TOKENS=1600
LLM_THINKING=false
SPEECH_TIMEOUT_SECONDS=180
LIPSYNC_TIMEOUT_SECONDS=60
# amplitude animates during playback; rhubarb generates phonetic cues before playback.
LIPSYNC_PROVIDER=amplitude
RHUBARB_ENGLISH_RECOGNIZER=phonetic
CANTONESE_TTS_ENABLED=true
CANTONESE_TTS_LANGUAGE=chinese
TTS_ENGLISH_VOICE=Vivian
TTS_CHINESE_VOICE=Vivian
TTS_CANTONESE_VOICE=Vivian
MEDIA_TTL_SECONDS=900
SESSION_TTL_SECONDS=3600
